{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xity4uu-a11y/db-vanguard/plugins/schema.json",
  "title": "db-vanguard Community Database Driver Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "protocol",
    "wire_transport",
    "default_port",
    "author",
    "license",
    "description",
    "capabilities",
    "streaming_export",
    "zero_c_deps",
    "min_core_version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Unique lowercase kebab-case driver plugin identifier."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "protocol": {
      "type": "string",
      "minLength": 2,
      "maxLength": 64
    },
    "wire_transport": {
      "type": "string",
      "enum": ["tcp", "file", "http", "in_process"]
    },
    "default_port": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 65535
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "license": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32
    },
    "description": {
      "type": "string",
      "minLength": 16,
      "maxLength": 280
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "query",
          "schema_inspect",
          "streaming_export",
          "transactions",
          "explain",
          "wal_inspect",
          "parquet_scan",
          "columnar_batch"
        ]
      }
    },
    "streaming_export": {
      "type": "boolean"
    },
    "zero_c_deps": {
      "type": "boolean"
    },
    "min_core_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
